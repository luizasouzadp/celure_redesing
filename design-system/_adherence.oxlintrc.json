{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/content/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumbs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Breadcrumbs> doesn't accept that prop. Declared props: items, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|href|onClick|icon|fullWidth|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, href, onClick, icon, fullWidth, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CloseButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClick|label|style|key|ref|className|style|children)$/]",
        "message": "<CloseButton> doesn't accept that prop. Declared props: onClick, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CookieBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|text|acceptLabel|declineLabel|onAccept|onDecline|onClose|position|key|ref|className|style|children)$/]",
        "message": "<CookieBanner> doesn't accept that prop. Declared props: open, text, acceptLabel, declineLabel, onAccept, onDecline, onClose, position."
      },
      {
        "selector": "JSXOpeningElement[name.name='CookieBanner'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|absolute|relative)$/]",
        "message": "<CookieBanner> position must be one of 'fixed' | 'absolute' | 'relative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|tagline|visualSrc|columns|contacts|copy|legalLinks|credit|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: brand, tagline, visualSrc, columns, contacts, copy, legalLinks, credit."
      },
      {
        "selector": "JSXOpeningElement[name.name='HairlineGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|children|edges|bleed|style|key|ref|className|style|children)$/]",
        "message": "<HairlineGrid> doesn't accept that prop. Declared props: columns, children, edges, bleed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HairlineGrid'] > JSXAttribute[name.name='edges'] > Literal[value!=/^(?:y|all|none)$/]",
        "message": "<HairlineGrid> edges must be one of 'y' | 'all' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|accentLabel|onNavigate|position|homeHref|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: brand, links, accentLabel, onNavigate, position, homeHref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|absolute|relative|static)$/]",
        "message": "<Header> position must be one of 'fixed' | 'absolute' | 'relative' | 'static'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|width|height|alt|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, width, height, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:pin|calendar|users|stars|step-1|step-2|step-3|step-4|location|earth|yoga|plus|close|close-hover|close-clicked|included-accommodation|included-integration|included-meals|sparkle|celure-mark)$/]",
        "message": "<Icon> name must be one of 'pin' | 'calendar' | 'users' | 'stars' | 'step-1' | 'step-2' | 'step-3' | 'step-4' | 'location' | 'earth' | 'yoga' | 'plus' | 'close' | 'close-hover' | 'close-clicked' | 'included-accommodation' | 'included-integration' | 'included-meals' | 'sparkle' | 'celure-mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IncludedList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|columns|key|ref|className|style|children)$/]",
        "message": "<IncludedList> doesn't accept that prop. Declared props: items, columns."
      },
      {
        "selector": "JSXOpeningElement[name.name='InputGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|as|type|name|placeholder|value|defaultValue|onChange|options|required|key|ref|className|style|children)$/]",
        "message": "<InputGroup> doesn't accept that prop. Declared props: label, as, type, name, placeholder, value, defaultValue, onChange, options, required."
      },
      {
        "selector": "JSXOpeningElement[name.name='InputGroup'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea|select)$/]",
        "message": "<InputGroup> as must be one of 'input' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='JourneyStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|subtitle|title|key|ref|className|style|children)$/]",
        "message": "<JourneyStep> doesn't accept that prop. Declared props: count, subtitle, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegalNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|activeIndex|onSelect|key|ref|className|style|children)$/]",
        "message": "<LegalNav> doesn't accept that prop. Declared props: items, activeIndex, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|caption|aspect|key|ref|className|style|children)$/]",
        "message": "<PersonCard> doesn't accept that prop. Declared props: image, name, caption, aspect."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|marginBottom|titleSize|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: eyebrow, title, children, marginBottom, titleSize."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='titleSize'] > Literal[value!=/^(?:h2|h3)$/]",
        "message": "<SectionHead> titleSize must be one of 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|image|aspect|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: title, subtitle, image, aspect."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|count|title|text|compact|key|ref|className|style|children)$/]",
        "message": "<StepItem> doesn't accept that prop. Declared props: icon, count, title, text, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepItem'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:step-1|step-2|step-3|step-4)$/]",
        "message": "<StepItem> icon must be one of 'step-1' | 'step-2' | 'step-3' | 'step-4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TripCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|priceLabel|price|image|properties|ctaLabel|onCta|href|key|ref|className|style|children)$/]",
        "message": "<TripCard> doesn't accept that prop. Declared props: title, priceLabel, price, image, properties, ctaLabel, onCta, href."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
