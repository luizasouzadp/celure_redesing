---
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean }
const {
  title = 'Celure Viagens e Turismo | Roteiros Sob Medida, Passagens Inteligentes & Consultoria de Milhas',
  description = 'Somos um estilo de viagem moderno, suave e autêntico. Viagens sob medida, emissão estratégica de passagens aéreas e consultoria de milhas de viajantes para viajantes.',
  noindex = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="Celure, Celure Viagens, Consultoria de Milhas, Passagens com Milhas, Roteiros Personalizados, Viagem de Classe Executiva, Lucas Celure">
  <meta name="theme-color" content="#091b20">
  {noindex && <meta name="robots" content="noindex">}

  <!-- Open Graph / Redes Sociais -->
  <meta property="og:title" content="Celure Viagens e Turismo | De Viajantes Para Viajantes">
  <meta property="og:description" content="Roteiros sob medida, passagens inteligentes e consultoria de milhas com atendimento 100% humano.">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:image" content="/assets/images/hero-photo.jpg">

  <link rel="icon" type="image/png" href="/assets/brand/celure-mark.png">
  <link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Ativa as animações de entrada só quando há JavaScript (sem JS, tudo aparece normalmente) -->
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <slot />

  <script>
    import '../scripts/cta';
    import '../scripts/reveal';
  </script>
</body>
</html>
