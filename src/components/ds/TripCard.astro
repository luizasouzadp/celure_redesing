---
// Cartão de serviço/viagem: título, destaque ("economia de  até 60%"), linhas de propriedades com
// ícone, botão secundário de largura total e foto à direita. Use dentro de um HairlineGrid.
import Icon from './Icon.astro';
import Button from './Button.astro';
export type TripProperty = { icon?: string; label: string; value: string | 'stars' };
interface Props {
  title: string;
  priceLabel?: string;
  price?: string;
  description?: string;
  image?: string;
  alt?: string;
  properties?: TripProperty[];
  ctaLabel?: string;
  ctaHref?: string;
  ctaAttrs?: Record<string, string>;
}
const { title, priceLabel, price, description, image, alt = '', properties = [], ctaLabel, ctaHref, ctaAttrs = {} } = Astro.props;
---
<article class="ds-trip-card">
  <div class="ds-trip-card__body">
    <div class="ds-trip-card__top">
      <h3 class="h4 ds-trip-card__title">{title}</h3>
      {(priceLabel || price) && (
        <p class="body-md ds-trip-card__price">
          {priceLabel && <span class="color-white-50">{priceLabel}</span>}
          {price && <span>{price}</span>}
        </p>
      )}
      {description && <p class="body-md color-white-60">{description}</p>}
    </div>
    <div class="ds-trip-card__bottom">
      {properties.length > 0 && (
        <dl class="ds-trip-card__props">
          {properties.map((p) => (
            <div class="ds-trip-card__prop">
              <dt class="title-xs color-white-60">{p.icon && <Icon name={p.icon} size=".875rem" />}{p.label}</dt>
              <dd class="title-xs">{p.value === 'stars' ? <Icon name="stars" width="3.3125rem" height=".5625rem" label="5 estrelas" /> : p.value}</dd>
            </div>
          ))}
        </dl>
      )}
      {ctaLabel && <Button variant="secondary" fullWidth href={ctaHref} {...ctaAttrs}>{ctaLabel}</Button>}
    </div>
  </div>
  {image && <div class="ds-trip-card__media"><img src={image} alt={alt} loading="lazy" decoding="async" /></div>}
</article>

<style>
  .ds-trip-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2.5rem; padding: var(--cell-pad); height: 100%; }
  .ds-trip-card__body { display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; }
  .ds-trip-card__top { display: flex; flex-direction: column; gap: .75rem; }
  .ds-trip-card__title { line-height: 100%; }
  .ds-trip-card__price { display: flex; gap: .25rem; }
  .ds-trip-card__bottom { display: flex; flex-direction: column; gap: 1.5rem; }
  .ds-trip-card__props { display: flex; flex-direction: column; gap: .6rem; margin: 0; }
  .ds-trip-card__prop { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .ds-trip-card__prop dt { display: flex; align-items: center; gap: .5rem; }
  .ds-trip-card__prop dd { margin: 0; text-align: right; }
  .ds-trip-card__media { width: 18.75rem; height: 20.125rem; overflow: hidden; }
  .ds-trip-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .ds-trip-card:hover .ds-trip-card__media img { transform: scale(1.04); }
  @media (max-width: 1199px) {
    .ds-trip-card__media { width: 14rem; height: auto; min-height: 18rem; }
  }
  @media (max-width: 599px) {
    .ds-trip-card { grid-template-columns: 1fr; gap: 1.5rem; }
    .ds-trip-card__media { order: -1; width: 100%; min-height: 0; aspect-ratio: 4 / 3; }
  }
</style>
