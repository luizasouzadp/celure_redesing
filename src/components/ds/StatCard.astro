---
// Célula com título + número curto (ex.: "Classe Executiva  / até 65% off") e uma foto vertical.
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  alt?: string;
  aspect?: string;
}
const { title, subtitle, image, alt = '', aspect = '400 / 437' } = Astro.props;
---
<div class="ds-stat-card">
  <span class="ds-stat-card__head">
    <span class="body-lg-semibold">{title}</span>
    {subtitle && <span class="body-md color-white-50 ds-stat-card__sub">{subtitle}</span>}
  </span>
  {image && (
    <span class="ds-stat-card__media" style={`aspect-ratio:${aspect}`}>
      <img src={image} alt={alt} loading="lazy" decoding="async" />
    </span>
  )}
</div>

<style>
  .ds-stat-card { display: block; width: 100%; padding: var(--cell-pad); }
  .ds-stat-card__head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .ds-stat-card__sub { white-space: nowrap; }
  .ds-stat-card__media { position: relative; display: block; width: 100%; overflow: hidden; }
  .ds-stat-card__media img { width: 100%; height: 100%; object-fit: cover; }
</style>
