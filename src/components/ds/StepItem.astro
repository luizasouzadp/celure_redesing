---
// Passo de "como funciona": ilustração de linha (step-1…4) + número pequeno, e embaixo título e texto.
import Icon from './Icon.astro';
interface Props { icon?: string; count?: string; title: string; text?: string; compact?: boolean }
const { icon, count, title, text, compact = false } = Astro.props;
---
<div class:list={['ds-step-item', { 'ds-step-item--compact': compact }]}>
  <div class="ds-step-item__head">
    {icon && <Icon name={icon} size="3.0625rem" />}
    {count && <span class="count">{count}</span>}
  </div>
  <div class="ds-step-item__body">
    <h3 class="h4">{title}</h3>
    {text && <p class="body-md color-white-60">{text}</p>}
    <slot />
  </div>
</div>

<style>
  .ds-step-item { display: flex; flex-direction: column; justify-content: space-between; gap: 8.375rem; height: 100%; }
  .ds-step-item--compact { justify-content: flex-start; gap: 3.5rem; }
  .ds-step-item__head { display: flex; gap: .75rem; }
  .ds-step-item__body { display: flex; flex-direction: column; gap: 1rem; }
  @media (max-width: 991px) { .ds-step-item { gap: 3rem; } }
</style>
