---
import Icon from './Icon.astro';
---
<!-- Section: Formulário de Cotação Rápida & Encaminhamento Inteligente -->
<section id="cotacao" class="py-20 bg-gradient-to-br from-slate-900 via-slate-900 to-teal-950 text-white relative overflow-hidden">
  <div class="absolute -top-24 right-0 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl"></div>
  
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center space-y-4 mb-12">
      <span class="text-xs uppercase font-bold tracking-widest text-teal-300 bg-teal-500/20 px-3 py-1 rounded-full border border-teal-500/30">
        Primeiro Passo Sem Compromisso
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Vamos planejar sua próxima grande experiência?
      </h2>
      <p class="text-slate-300 text-base max-w-xl mx-auto">
        Preencha os dados abaixo para que possamos entender seu desejo e iniciar o atendimento exclusivo direto no WhatsApp.
      </p>
    </div>

    <!-- Quote Form Box -->
    <div class="glass-card-dark rounded-3xl p-6 sm:p-10 border border-white/10 shadow-2xl">
      <form id="celure-quote-form" class="space-y-6">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="quote-name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
              Seu Nome Completo:
            </label>
            <input type="text" id="quote-name" required placeholder="Ex: Lucas Silva" class="w-full bg-slate-800/90 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-teal-400">
          </div>

          <div>
            <label for="quote-service" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
              Serviço de Maior Interesse:
            </label>
            <select id="quote-service" class="w-full bg-slate-800/90 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:ring-2 focus:ring-teal-400">
              <option value="Emissão Inteligente de Passagens Aéreas">Emissão Inteligente de Passagens (Milhas/Dinheiro)</option>
              <option value="Planejamento de Roteiro Sob Medida">Planejamento & Roteiro Sob Medida</option>
              <option value="Consultoria de Milhas e Cartões de Crédito">Consultoria de Milhas & Cartões de Crédito</option>
              <option value="Viagens Exclusivas & Experiências Premium">Viagens Exclusivas & Experiências Premium</option>
              <option value="Viagem Completa (Voo + Hotel + Roteiro)">Viagem Completa (Voo + Hotel + Roteiro)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div>
            <label for="quote-destination" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
              Destino Desejado:
            </label>
            <input type="text" id="quote-destination" placeholder="Ex: Bariloche / Paris / Noronha" class="w-full bg-slate-800/90 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-teal-400">
          </div>

          <div>
            <label for="quote-dates" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
              Época / Mês Previsto:
            </label>
            <input type="text" id="quote-dates" placeholder="Ex: Julho / Réveillon / Flexível" class="w-full bg-slate-800/90 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-teal-400">
          </div>

          <div>
            <label for="quote-travelers" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
              Viajantes:
            </label>
            <select id="quote-travelers" class="w-full bg-slate-800/90 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:ring-2 focus:ring-teal-400">
              <option value="1 pessoa (Solo)">1 pessoa (Solo)</option>
              <option value="2 pessoas (Casal/Amigos)">2 pessoas (Casal/Amigos)</option>
              <option value="3 a 4 pessoas (Família)">3 a 4 pessoas (Família)</option>
              <option value="5+ pessoas (Grupo)">5+ pessoas (Grupo)</option>
            </select>
          </div>
        </div>

        <div>
          <label for="quote-details" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
            Detalhes Adicionais (Opcional):
          </label>
          <textarea id="quote-details" rows="3" placeholder="Conte mais sobre o estilo de viagem que você busca, se deseja voar em classe executiva, se já possui milhas em algum programa..." class="w-full bg-slate-800/90 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-teal-400"></textarea>
        </div>

        <button type="submit" class="w-full py-4 rounded-xl bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-base shadow-lg shadow-teal-500/25 flex items-center justify-center gap-3 transition-all hover:scale-[1.01]">
          <Icon name="message-circle" class="w-5 h-5" />
          <span>Enviar Solicitação para o WhatsApp</span>
        </button>

        <p class="text-xs text-slate-400 text-center">
          🔒 Seus dados são confidenciais e utilizados estritamente para montar sua proposta de viagem.
        </p>

      </form>
    </div>

  </div>
</section>

<script>
  // Formulário de cotação: monta a mensagem e abre o WhatsApp em nova aba
  import { buildQuoteMessage, getWhatsAppUrl } from '../lib/whatsapp';

  const form = document.getElementById('celure-quote-form') as HTMLFormElement | null;
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value ?? '';

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const message = buildQuoteMessage({
      name: val('quote-name'),
      service: val('quote-service'),
      destination: val('quote-destination'),
      dates: val('quote-dates'),
      travelers: val('quote-travelers'),
      details: val('quote-details'),
    });
    window.open(getWhatsAppUrl(message), '_blank');
  });
</script>
