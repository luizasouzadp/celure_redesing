---
import Icon from './Icon.astro';
import { servicos } from '../data/servicos';
---
<!-- Section: Serviços Prestados (Sem Pacotes de Prateleira) -->
<section id="servicos" class="py-20 bg-[#FAF5EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="text-xs uppercase font-bold tracking-widest text-teal-700 bg-teal-100/70 px-3 py-1 rounded-full border border-teal-200">
        Como Podemos Te Ajudar
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Soluções completas e sob medida para sua viagem
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Não trabalhamos com pacotes prontos de gaveta. Cada solicitação é analisada individualmente para entregar a melhor estratégia de rotas, milhas e vivências.
      </p>
    </div>

    <!-- Coverflow de Serviços -->
    <div class="relative mt-14 max-w-5xl mx-auto">

      <div class="relative h-[500px] sm:h-[420px] overflow-hidden" id="coverflow-track">

        {servicos.map((s, i) => (
          <div class="coverflow-card" data-index={i} data-coverflow-goto={i}>
            <div class="bg-white rounded-3xl border border-slate-200/80 shadow-lg overflow-hidden h-full flex flex-col">
              <div class="relative h-60 shrink-0">
                <img src={s.img} class="w-full h-full object-cover" alt={s.alt}>
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
                <div class={`absolute top-3 left-3 w-10 h-10 rounded-xl bg-white/90 ${s.iconClass} flex items-center justify-center`}>
                  <Icon name={s.icon} class="w-5 h-5" />
                </div>
              </div>
              <div class="p-4 flex flex-col flex-1 justify-between">
                <div class="space-y-2">
                  <h3 class="text-base font-bold text-slate-900">{s.titulo}</h3>
                  <p class="text-slate-600 text-xs leading-relaxed">
                    {s.descricao}
                  </p>
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {s.tags.map((tag) => (
                      <span class={`px-2 py-0.5 rounded-full text-[10px] font-semibold border ${s.tagClass}`}>{tag}</span>
                    ))}
                  </div>
                </div>
                <a href="#cotacao" data-cta-service={s.cta} class="mt-3 w-full py-2.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors">
                  <Icon name="message-circle" class="w-3.5 h-3.5" />
                  <span>{s.ctaLabel}</span>
                </a>
              </div>
            </div>
          </div>
        ))}

      </div>

      <!-- Setas fixas nas bordas -->
      <button type="button" data-coverflow-nav="-1" class="coverflow-arrow -left-2 sm:-left-6" aria-label="Serviço anterior">
        <Icon name="chevron-left" class="w-5 h-5 text-slate-700" />
      </button>
      <button type="button" data-coverflow-nav="1" class="coverflow-arrow -right-2 sm:-right-6" aria-label="Próximo serviço">
        <Icon name="chevron-right" class="w-5 h-5 text-slate-700" />
      </button>

    </div>

  </div>
</section>

<script>
  // Coverflow: card ativo no centro, vizinhos menores dos lados, o resto escondido
  import { coverflowPose, wrapIndex } from '../lib/carousel';

  const cards = [...document.querySelectorAll<HTMLElement>('.coverflow-card')];
  const count = cards.length;
  let active = 0;

  function render() {
    cards.forEach((card) => {
      const p = coverflowPose(Number(card.dataset.index), active, count);
      card.style.transform = `translateX(-50%) translateX(${p.translateX}px) scale(${p.scale})`;
      card.style.opacity = String(p.opacity);
      card.style.zIndex = String(p.zIndex);
      card.style.pointerEvents = p.pointerEvents;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-coverflow-nav]').forEach((btn) =>
    btn.addEventListener('click', () => {
      active = wrapIndex(active + Number(btn.dataset.coverflowNav), count);
      render();
    }));
  cards.forEach((card) =>
    card.addEventListener('click', () => {
      active = Number(card.dataset.coverflowGoto);
      render();
    }));
  render();
</script>
