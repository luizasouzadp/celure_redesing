---
import { celure } from '../config/celure';
---
<!-- Top Announcement Bar -->
<div class="bg-celure-navy text-white text-xs sm:text-sm py-2.5 px-4 border-b border-teal-900/40">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
    <div class="flex items-center justify-center gap-2">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-teal-500/20 text-teal-300 border border-teal-500/30">
        ✈️ Autenticidade Real
      </span>
      <span class="text-slate-300 font-medium">"Somos um estilo de viagem moderno, suave e autêntico"</span>
    </div>
    <div class="flex items-center gap-4 text-slate-300 text-xs">
      <span class="hidden md:inline">CNPJ: {celure.cnpj}</span>
      <a href={`https://instagram.com/${celure.instagram}`} target="_blank" rel="noopener noreferrer" class="hover:text-teal-400 flex items-center gap-1 transition-colors">
        <i data-lucide="instagram" class="w-3.5 h-3.5"></i> @{celure.instagram}
      </a>
    </div>
  </div>
</div>
