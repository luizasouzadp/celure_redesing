---
import Icon from './Icon.astro';
---
<!-- Floating WhatsApp Action Button -->
<a href="#cotacao" class="fixed bottom-6 right-6 z-50 p-4 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white shadow-2xl transition-all hover:scale-110 flex items-center justify-center animate-pulse-subtle group" aria-label="Falar no WhatsApp">
  <Icon name="message-circle" class="w-7 h-7" />
  <span class="max-w-0 overflow-hidden whitespace-nowrap group-hover:max-w-xs transition-all duration-300 ease-in-out font-bold text-xs group-hover:ml-2">
    Falar com a Celure
  </span>
</a>
