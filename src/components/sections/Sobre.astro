---
// Sobre Nós: texto curto à esquerda, sobre o fundo escuro, e a foto de viagem à direita, com as pessoas
// no centro dela — o texto nunca passa por cima de rostos. Os 3 pilares ficam numa faixa de vidro
// fosco na base (o padrão "foto + faixa desfocada" do design system).
// Foto: Capadócia (a mesma da abertura por enquanto; a abertura vai ganhar outra foto).
import Eyebrow from '../ds/Eyebrow.astro';
import HairlineGrid from '../ds/HairlineGrid.astro';
import JourneyStep from '../ds/JourneyStep.astro';

const pilares = [
  { titulo: 'Autenticidade comprovada', frase: 'Experiência vivida na pele' },
  { titulo: 'Inteligência em milhas', frase: 'Mais conforto pagando menos' },
  { titulo: 'Seu tempo de volta', frase: 'Zero estresse no planejamento' },
];
---
<section id="sobre" class="sobre" aria-labelledby="sobre-title">
  <div class="sobre__media">
    <img src="/assets/images/hero-photo.jpg" alt="Casal diante das chaminés de fada da Capadócia, Turquia" loading="lazy" decoding="async" />
  </div>

  <div class="container sobre__content">
    <Eyebrow>Sobre Nós</Eyebrow>
    <h2 id="sobre-title" class="h2">Muito mais do que uma agência. <span class="color-white-40">Um estilo de viagem moderno e humano.</span></h2>
    <p class="body-xl sobre__lead" data-reveal>Criada por Lucas (@mullermilhas), que testa cada destino antes de indicar.</p>
  </div>

  <div class="sobre__strip">
    <HairlineGrid columns={3} tablet={3} mobile={1}>
      {pilares.map((p, i) => (
        <div data-reveal style={`--d:${i * 0.1}s`}>
          <JourneyStep count={String(i + 1).padStart(2, '0')} subtitle={p.frase} title={p.titulo} />
        </div>
      ))}
    </HairlineGrid>
  </div>
</section>

<style>
  .sobre { position: relative; min-height: max(100svh, 50rem); display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }

  /* Foto ocupa a direita e some para a esquerda (onde está o texto), em cima e embaixo */
  .sobre__media {
    position: absolute; top: 0; bottom: 0; right: 0; left: 38%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 30%), linear-gradient(to bottom, transparent, #000 15%, #000 80%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 30%), linear-gradient(to bottom, transparent, #000 15%, #000 80%, transparent);
    mask-composite: intersect;
  }
  .sobre__media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; }

  .sobre__content {
    position: relative; z-index: 1; display: flex; flex-direction: column; gap: 1.5rem;
    padding-top: calc(var(--section-pad) * 1.5); padding-bottom: var(--section-pad);
  }
  .sobre__content .h2 { max-width: 34rem; }
  .sobre__lead { max-width: 28rem; margin-top: 1rem; }

  .sobre__strip { position: relative; z-index: 1; -webkit-backdrop-filter: blur(var(--blur-strip)); backdrop-filter: blur(var(--blur-strip)); }

  /* Tablet e celular: foto em cima, texto embaixo — nada sobreposto */
  @media (max-width: 991px) {
    .sobre { min-height: 0; }
    .sobre__media {
      position: relative; left: 0; height: 26rem;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 15%, #000 70%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 15%, #000 70%, transparent);
    }
    .sobre__content { padding-top: 0; margin-top: -2rem; }
  }
  @media (max-width: 479px) {
    .sobre__media { height: 20rem; }
  }
</style>
