---
// Abertura com vídeo guiado pela rolagem (não toca sozinho). Roteiro, conforme o progresso --p (0 → 1):
//   0 → 0,70  o vídeo avança quadro a quadro, sem texto por cima (só o indicador "Role para embarcar")
//   0,70 → 0,85  o último quadro fica de fundo, escurece, e a frase de impacto surge no centro
//   0,85 → 1  a frase segura na tela; depois a página segue normalmente
// Quadros extraídos do vídeo em public/assets/hero-embarque (ver DESIGN.md para trocar o vídeo).
const FRAMES = 96;
const frame = (i: number) => `/assets/hero-embarque/${String(i).padStart(3, '0')}.webp`;
const provas = [
  { n: '+30', t: 'Países explorados pelo fundador' },
  { n: '100%', t: 'Roteiros sob medida & humanos' },
  { n: 'Até 60%', t: 'De economia em passagens e upgrades' },
];
---
<section id="hero" class="hero" aria-labelledby="hero-title" data-frames={FRAMES}>
  <div class="hero__sticky">
    <div class="hero__media">
      <img class="hero__poster" src={frame(1)} alt="" fetchpriority="high" width="1024" height="576" />
      <canvas id="hero-canvas" class="hero__canvas" aria-hidden="true" data-frame="0"></canvas>
    </div>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__word">Viaje</span>
      <span class="h3 hero__lead">com mais conforto e use as milhas a seu favor.</span>
    </h1>

    <div class="hero__scroll" aria-hidden="true">
      <span class="title-xs">Role para embarcar</span>
      <span class="hero__track"><span class="hero__bar"></span></span>
    </div>
  </div>
</section>

<ul class="hero__proof">
  {provas.map((p) => (
    <li>
      <span class="h3">{p.n}</span>
      <span class="body-sm color-white-60">{p.t}</span>
    </li>
  ))}
</ul>

<script>
  // Liga a rolagem ao vídeo: calcula o progresso (0 a 1) da seção, guarda em --p (que o CSS usa
  // para os efeitos) e desenha no canvas o quadro correspondente. O movimento é suavizado.
  const section = document.getElementById('hero');
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && canvas) {
    const total = Number(section.dataset.frames);
    const ctx = canvas.getContext('2d')!;
    const src = (i: number) => `/assets/hero-embarque/${String(i + 1).padStart(3, '0')}.webp`;
    const frames: HTMLImageElement[] = Array.from({ length: total }, () => new Image());
    const VIDEO_END = 0.7; // o vídeo termina em 70% da rolagem; depois vem a frase

    let target = 0;
    let current = 0;
    let drawn = -1;
    let running = false;

    const progress = () => {
      const r = section.getBoundingClientRect();
      const room = r.height - innerHeight;
      return room > 0 ? Math.min(1, Math.max(0, -r.top / room)) : 1;
    };
    const frameAt = (p: number) => Math.round(Math.min(1, p / VIDEO_END) * (total - 1));

    // Desenha cobrindo a tela inteira (como object-fit: cover)
    function draw(i: number) {
      let img = frames[i];
      // se o quadro ainda não chegou, usa o mais próximo já carregado
      for (let d = 1; !(img.complete && img.naturalWidth) && d <= i; d++) img = frames[i - d];
      if (!(img.complete && img.naturalWidth)) return;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const w = Math.round(canvas!.clientWidth * dpr);
      const h = Math.round(canvas!.clientHeight * dpr);
      if (canvas!.width !== w || canvas!.height !== h) { canvas!.width = w; canvas!.height = h; drawn = -1; }
      if (drawn === i) return;
      const s = Math.max(w / img.naturalWidth, h / img.naturalHeight);
      const dw = img.naturalWidth * s;
      const dh = img.naturalHeight * s;
      ctx.drawImage(img, (w - dw) / 2, (h - dh) * (w > h ? 0.35 : 0.15), dw, dh);
      drawn = i;
      canvas!.dataset.frame = String(i);
      canvas!.classList.add('is-ready');
    }

    function tick() {
      current += (target - current) * 0.18;
      if (Math.abs(target - current) < 0.0005) current = target;
      section!.style.setProperty('--p', current.toFixed(4));
      draw(frameAt(current));
      if (current !== target) requestAnimationFrame(tick);
      else running = false;
    }
    function onScroll() {
      target = progress();
      if (!running) { running = true; requestAnimationFrame(tick); }
    }

    if (reduce) {
      // Menos animação: mostra direto o final (último quadro + frase), sem efeito de rolagem
      current = target = 1;
      section.style.setProperty('--p', '1');
      const last = frames[total - 1];
      last.onload = () => draw(total - 1);
      last.src = src(total - 1);
    } else {
      // Carrega todos os quadros; redesenha quando o quadro da vez chega
      frames.forEach((img, i) => {
        img.decoding = 'async';
        img.onload = () => { if (i === 0 || i === frameAt(current)) { drawn = -1; draw(frameAt(current)); } };
        img.src = src(i);
      });
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', () => { drawn = -1; onScroll(); });
      onScroll();
    }
  }
</script>

<style>
  /* A seção é alta: enquanto a pessoa rola por ela, a tela fica presa no vídeo */
  .hero { --p: 0; position: relative; height: 320svh; }
  .hero__sticky {
    position: sticky; top: 0; height: 100svh; display: flex; align-items: center; justify-content: center; overflow: hidden;
    /* --t: entrada da frase, entre 70% e 85% da rolagem */
    --t: clamp(0, calc((var(--p) - .7) / .15), 1);
  }

  .hero__media { position: absolute; inset: 0; overflow: hidden; }
  .hero__poster, .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__poster { object-fit: cover; object-position: 50% 35%; }
  .hero__canvas { opacity: 0; transform: scale(calc(1 + .06 * var(--t))); }
  .hero__canvas.is-ready { opacity: 1; }
  /* Escurece o último quadro para a frase aparecer bem (e, de leve, a base do vídeo o tempo todo) */
  .hero__media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(9, 27, 32, .6) 0%, transparent 30%),
      rgba(9, 27, 32, calc(.6 * var(--t)));
  }

  /* A frase de impacto: "Viaje" enorme se fecha no lugar (espaçamento e desfoque diminuem) e a
     frase de apoio sobe logo depois */
  .hero__title {
    position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 1.5rem;
    /* um pouco abaixo do centro: no último quadro o rosto da pessoa costuma ficar no terço de cima */
    padding: 22svh var(--container-pad) 0; text-align: center; font-weight: 600;
  }
  .hero__word {
    display: block; font-size: clamp(var(--h1-size), 20vw, 22rem); line-height: .9;
    --e: clamp(0, calc((var(--t) - 0) / .75), 1);
    opacity: var(--e);
    letter-spacing: calc(.35em - .41em * var(--e));
    filter: blur(calc(14px * (1 - var(--e))));
    /* compensa o espaço que sobra depois da última letra, para a palavra ficar bem no centro */
    margin-right: calc(-1 * (.35em - .41em * var(--e)));
  }
  .hero__lead {
    display: block; max-width: 44rem;
    --l: clamp(0, calc((var(--t) - .45) / .55), 1);
    opacity: var(--l); transform: translateY(calc(2rem * (1 - var(--l))));
  }

  /* Indicador de rolagem: um fio que se preenche de laranja conforme o vídeo avança */
  .hero__scroll {
    position: absolute; z-index: 1; left: var(--container-pad); right: var(--container-pad); bottom: 2rem;
    display: flex; align-items: center; gap: 1.5rem; color: var(--white-60);
    opacity: calc(1 - var(--t) * 2);
  }
  .hero__track { position: relative; flex: 1; height: 1px; background: var(--white-20); }
  .hero__bar { position: absolute; inset: 0; background: var(--brand-accent); transform-origin: left; transform: scaleX(clamp(0, calc(var(--p) / .7), 1)); }

  .hero__proof { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--line-hairline); }
  .hero__proof li { display: flex; align-items: baseline; gap: 1rem; padding: 1.75rem var(--container-pad); }
  .hero__proof li + li { border-left: 1px solid var(--line-hairline); }
  .hero__proof .body-sm { max-width: 11rem; }

  @media (max-width: 991px) {
    .hero { height: 280svh; }
    .hero__proof { grid-template-columns: 1fr; }
    .hero__proof li { padding: 1.25rem var(--container-pad); }
    .hero__proof li + li { border-left: 0; border-top: 1px solid var(--line-hairline); }
  }
  /* Celular: o vídeo fica abaixo do menu */
  @media (max-width: 767px) {
    .hero__media { top: var(--header-height); }
    .hero__word { font-size: 7rem; }
  }

  /* Sem JavaScript, a frase aparece normalmente sobre o primeiro quadro */
  :global(html:not(.js)) .hero { height: auto; }
  :global(html:not(.js)) .hero__sticky { position: relative; --t: 1; }

  /* Menos animação: abertura de altura normal, já no final (último quadro + frase) */
  @media (prefers-reduced-motion: reduce) {
    .hero { height: auto; }
    .hero__sticky { position: relative; }
    .hero__scroll { display: none; }
  }
</style>
