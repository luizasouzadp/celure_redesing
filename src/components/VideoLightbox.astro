---
import Icon from './Icon.astro';
---
<!-- Lightbox de Vídeo (Lounge / Primeira Classe / Destino) -->
<div id="card-video-lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-950/95 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-label="Vídeo">
  <button id="card-video-close" class="absolute top-5 right-5 sm:top-8 sm:right-8 text-white/80 hover:text-white p-2 rounded-full hover:bg-white/10 transition-colors" aria-label="Fechar">
    <Icon name="x" class="w-7 h-7" />
  </button>

  <div class="max-w-md w-full flex flex-col items-center gap-4">
    <video id="card-video-player" class="w-full max-h-[80vh] rounded-2xl shadow-2xl border border-white/10 bg-black" controls playsinline></video>
    <div class="text-center">
      <span id="card-video-eyebrow" class="text-[11px] font-mono text-teal-300 block font-bold"></span>
      <p id="card-video-title" class="text-white font-bold text-lg mt-1"></p>
    </div>
  </div>
</div>

<script>
  // Vídeo-cards das "janelas de avião": clique abre o vídeo grande, com som
  const box = document.getElementById('card-video-lightbox')!;
  const player = document.getElementById('card-video-player') as HTMLVideoElement;

  function open(src: string, title: string, eyebrow: string) {
    player.src = src;
    document.getElementById('card-video-title')!.textContent = title;
    document.getElementById('card-video-eyebrow')!.textContent = eyebrow;
    box.classList.remove('hidden');
    box.classList.add('flex');
    player.play();
  }

  function close() {
    player.pause();
    player.currentTime = 0;
    player.removeAttribute('src');
    player.load();
    box.classList.add('hidden');
    box.classList.remove('flex');
  }

  document.querySelectorAll<HTMLElement>('[data-video-src]').forEach((el) =>
    el.addEventListener('click', () => open(el.dataset.videoSrc!, el.dataset.videoTitle!, el.dataset.videoEyebrow!)));
  box.addEventListener('click', (e) => { if (e.target === box) close(); });
  document.getElementById('card-video-close')?.addEventListener('click', (e) => { e.stopPropagation(); close(); });
  document.addEventListener('keydown', (e) => {
    if (box.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
  });
</script>
