---
// Gera em build o mesmo <svg> que o lucide.createIcons() criava no navegador
import * as icons from 'lucide-static';

interface Props { name: string; class?: string }
const { name, class: className = '' } = Astro.props;
const pascal = name.replace(/(^|-)([a-z0-9])/g, (_, __, c) => c.toUpperCase());
const svg = (icons as unknown as Record<string, string>)[pascal];
if (!svg) throw new Error(`Ícone Lucide não encontrado: ${name}`);
const html = svg
  .replace(/<!--[\s\S]*?-->/g, '')
  .trim()
  .replace(/\s+/g, ' ')
  .replace(/class="([^"]*)"/, `data-lucide="${name}" aria-hidden="true" class="$1${className ? ' ' + className : ''}"`);
---
<Fragment set:html={html} />
