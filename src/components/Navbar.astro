---
import Icon from './Icon.astro';
---
<!-- Main Navigation (Sticky Glass) -->
<header id="navbar" class="sticky top-0 z-50 transition-all duration-300 glass-nav py-4">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    
    <!-- Brand Logo Oficial Transparente -->
    <a href="#" class="flex items-center gap-2 group">
      <img src="/assets/images/celure-logo.png" alt="Celure Viagens e Turismo" class="h-10 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform duration-300">
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-700">
      <a href="#sobre" class="hover:text-teal-700 transition-colors">Sobre Nós</a>
      <a href="#luxo" class="hover:text-teal-700 transition-colors flex items-center gap-1 font-semibold text-teal-800">
        <Icon name="crown" class="w-3.5 h-3.5 text-amber-500" />
        <span>Experiência VIP</span>
      </a>
      <a href="#depoimentos" class="hover:text-teal-700 transition-colors">Clientes & Histórias</a>
      <a href="#servicos" class="hover:text-teal-700 transition-colors">Serviços</a>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-toggle" class="lg:hidden p-2 text-slate-700 hover:text-teal-700 focus:outline-none" aria-label="Abrir menu">
      <Icon name="menu" class="w-6 h-6" />
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white/95 backdrop-blur-xl border-b border-slate-200 px-6 py-5 shadow-xl transition-all">
    <div class="flex flex-col gap-4 text-base font-medium text-slate-800">
      <a href="#sobre" class="mobile-nav-link hover:text-teal-700">Sobre Nós</a>
      <a href="#luxo" class="mobile-nav-link hover:text-teal-700 text-teal-800 font-semibold flex items-center gap-1.5">
        <Icon name="crown" class="w-4 h-4 text-amber-500" /> Experiência VIP & Luxo
      </a>
      <a href="#depoimentos" class="mobile-nav-link hover:text-teal-700">Clientes & Histórias</a>
      <a href="#servicos" class="mobile-nav-link hover:text-teal-700">Serviços</a>
      <a href="#cotacao" class="mobile-nav-link mt-2 text-center py-3 rounded-xl bg-teal-700 text-white font-semibold flex items-center justify-center gap-2">
        <Icon name="message-circle" class="w-5 h-5" /> Falar no WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  // Efeito de rolagem: navbar mais compacto e com sombra depois de 40px
  const navbar = document.getElementById('navbar');
  if (navbar) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        navbar.classList.add('shadow-md', 'py-3');
        navbar.classList.remove('py-5');
      } else {
        navbar.classList.remove('shadow-md', 'py-3');
        navbar.classList.add('py-5');
      }
    });
  }

  // Menu mobile: botão abre/fecha, clicar num link fecha
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => menu.classList.toggle('hidden'));
    document.querySelectorAll('.mobile-nav-link').forEach((link) =>
      link.addEventListener('click', () => menu.classList.add('hidden')));
  }
</script>
