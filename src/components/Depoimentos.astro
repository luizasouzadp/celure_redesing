---
import Icon from './Icon.astro';
import { depoimentos } from '../data/depoimentos';
---
<!-- Section: Clientes & Depoimentos Reais -->
<section id="depoimentos" class="py-20 bg-white border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
      <div class="space-y-3 max-w-2xl">
        <span class="text-xs uppercase font-bold tracking-widest text-teal-700 bg-teal-50 px-3 py-1 rounded-full border border-teal-200/60">
          Prova Social Recorrente
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Histórias de quem viajou de verdade com a Celure
        </h2>
        <p class="text-slate-600 text-base">
          De viagens internacionais em classe executiva a roteiros em família e aventuras na neve com grupos de amigos.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <div class="flex text-amber-400">
          <Icon name="star" class="w-5 h-5 fill-current" />
          <Icon name="star" class="w-5 h-5 fill-current" />
          <Icon name="star" class="w-5 h-5 fill-current" />
          <Icon name="star" class="w-5 h-5 fill-current" />
          <Icon name="star" class="w-5 h-5 fill-current" />
        </div>
        <span class="text-sm font-bold text-slate-800">5.0 de Avaliação</span>
      </div>
    </div>

    <!-- Carrossel de Depoimentos Reais -->
    <div class="relative">

      <div id="testimonial-carousel" class="flex gap-6 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth" style="scrollbar-width: thin;">

        {depoimentos.map((d) => (
          <div class="shrink-0 w-[280px] sm:w-[320px] snap-start bg-[#FAF5EE] rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm card-hover-lift">
            <div class="relative h-64">
              <img src={d.img} class="w-full h-full object-cover" alt={d.alt}>
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-transparent"></div>
              {d.likes !== undefined ? (
                <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between">
                  <span class="text-white font-bold text-sm drop-shadow">{d.local}</span>
                  <span class="flex items-center gap-1 text-white text-xs bg-black/30 backdrop-blur px-2 py-1 rounded-full">
                    <Icon name="heart" class="w-3 h-3 fill-current text-red-400" /> {d.likes}
                  </span>
                </div>
              ) : (
                <div class="absolute bottom-3 left-4 right-4">
                  <span class="text-white font-bold text-sm drop-shadow">{d.local}</span>
                </div>
              )}
            </div>
            <div class="p-5">
              <p class="text-slate-700 text-sm leading-relaxed">
                {d.texto}
              </p>
              <p class="mt-3 text-xs font-bold text-teal-700">{d.assinatura}</p>
            </div>
          </div>
        ))}

      </div>

      <!-- Setas de navegação (desktop) -->
      <button type="button" data-testimonial-scroll="-1" class="hidden md:flex absolute -left-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-lg border border-slate-200 items-center justify-center hover:bg-slate-50 transition-colors" aria-label="Depoimentos anteriores">
        <Icon name="chevron-left" class="w-5 h-5 text-slate-700" />
      </button>
      <button type="button" data-testimonial-scroll="1" class="hidden md:flex absolute -right-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-lg border border-slate-200 items-center justify-center hover:bg-slate-50 transition-colors" aria-label="Próximos depoimentos">
        <Icon name="chevron-right" class="w-5 h-5 text-slate-700" />
      </button>

    </div>

  </div>
</section>

<script>
  // Setas do carrossel: rolam a largura de um card + o espaço entre eles (gap-6 = 24px)
  const track = document.getElementById('testimonial-carousel');
  document.querySelectorAll<HTMLElement>('[data-testimonial-scroll]').forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!track) return;
      const card = track.querySelector('div');
      const width = card ? card.offsetWidth + 24 : 320;
      track.scrollBy({ left: width * Number(btn.dataset.testimonialScroll), behavior: 'smooth' });
    }));
</script>
